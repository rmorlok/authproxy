---
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  article?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title = 'AuthProxy Blog',
  description = 'Practical guidance for building and operating secure third-party API integrations with AuthProxy.',
  canonicalPath,
  image,
  article = false,
  publishedAt,
  updatedAt,
  tags = [],
  noindex = false,
} = Astro.props;
const site = new URL('https://blog.authproxy.net');
const canonical = new URL(canonicalPath ?? Astro.url.pathname, site).href;
const socialImage = new URL(image ?? '/social-card.svg', site).href;
const documentTitle = title === 'AuthProxy Blog' ? title : `${title} | AuthProxy Blog`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="AuthProxy Blog" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content="AuthProxy Blog" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {article && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {article && updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-content">
        <a class="site-brand" href="/" aria-label="AuthProxy Blog home">
          <span class="brand-mark" aria-hidden="true">A</span>
          <span>AuthProxy <strong>Blog</strong></span>
        </a>
        <nav aria-label="Primary navigation">
          <a href="/">Articles</a>
          <a href="https://docs.authproxy.net">Docs</a>
          <a href="https://github.com/rmorlok/authproxy">GitHub</a>
          <ThemeToggle />
        </nav>
      </div>
    </header>
    <main class="shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">
        <span>AuthProxy Blog</span>
        <a href="https://docs.authproxy.net">Documentation</a>
        <a href="/rss.xml">RSS</a>
      </div>
    </footer>
  </body>
</html>
