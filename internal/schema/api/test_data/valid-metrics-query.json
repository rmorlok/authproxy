{
  "range": {
    "start": "2026-05-25T12:00:00Z",
    "end": "2026-05-25T13:00:00Z",
    "step": "15m"
  },
  "namespace": "root.**",
  "labelSelector": "env=prod",
  "queries": [
    {
      "refId": "requests",
      "metric": "request_events",
      "aggregation": "count",
      "groupBy": [
        "method",
        "response_status_code"
      ]
    },
    {
      "refId": "connections",
      "metric": "resources.connections",
      "aggregation": "count",
      "groupBy": [
        "state",
        "health_state"
      ]
    }
  ]
}
