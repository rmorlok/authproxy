{
  "apiVersion": "authproxy.net/v1alpha1",
  "kind": "RateLimit",
  "metadata": {
    "name": "analytics-reports",
    "namespace": "root.acme",
    "labels": {"team": "analytics"}
  },
  "spec": {
    "scope": {"namespaceMatcher": "root.acme.analytics.**"},
    "selector": {
      "methods": ["GET"],
      "pathMatch": {"kind": "glob", "value": "/reports/*"}
    },
    "bucket": {"dimensions": ["connection"]},
    "algorithm": {"slidingWindow": {"window": "5m", "limit": 500, "mode": "counter"}}
  }
}
