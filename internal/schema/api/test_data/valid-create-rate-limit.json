{
  "namespace": "root.acme",
  "definition": {
    "mode": "enforce",
    "selector": {
      "methods": [
        "GET"
      ],
      "pathMatch": {
        "kind": "glob",
        "value": "/reports/*"
      }
    },
    "bucket": {
      "dimensions": [
        "connection"
      ]
    },
    "algorithm": {
      "slidingWindow": {
        "window": "5m",
        "limit": 500,
        "mode": "counter"
      }
    }
  },
  "labels": {
    "team": "analytics"
  }
}
