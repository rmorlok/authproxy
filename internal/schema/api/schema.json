{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rmorlok/authproxy/refs/heads/main/schema/api/schema.json",
  "$defs": {
    "ConnectionSetupResponseType": {
      "type": "string",
      "enum": [
        "redirect",
        "form",
        "complete",
        "verifying",
        "error"
      ]
    },
    "NamespaceState": {
      "type": "string",
      "enum": [
        "active",
        "destroying",
        "destroyed"
      ]
    },
    "ConnectorVersionState": {
      "type": "string",
      "enum": [
        "draft",
        "primary",
        "active",
        "archived"
      ]
    },
    "ConnectionState": {
      "type": "string",
      "enum": [
        "setup",
        "configured",
        "disabled",
        "disconnecting",
        "disconnected"
      ]
    },
    "ConnectionHealthState": {
      "type": "string",
      "enum": [
        "healthy",
        "unhealthy"
      ]
    },
    "NotificationLevel": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "NotificationState": {
      "type": "string",
      "enum": [
        "active",
        "resolved"
      ]
    },
    "KeyState": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ]
    },
    "StringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "SearchResourceType": {
      "type": "string",
      "enum": [
        "actor",
        "connection",
        "connector",
        "namespace",
        "key",
        "rate_limit"
      ]
    },
    "SearchLabelMatch": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "additionalProperties": false
    },
    "SearchResourceSummary": {
      "type": "object",
      "properties": {
        "resourceType": {
          "$ref": "#/$defs/SearchResourceType"
        },
        "resourceId": {
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "../common/schema.json#/$defs/ResourceName"
            },
            {
              "$ref": "../resources/namespace/schema.json#/$defs/NamespaceName"
            }
          ]
        },
        "namespace": {
          "$ref": "../resources/namespace/schema.json#/$defs/NamespacePath"
        },
        "labels": {
          "$ref": "#/$defs/StringMap"
        },
        "matchedLabels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SearchLabelMatch"
          }
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "resourceType",
        "resourceId",
        "name",
        "namespace",
        "labels",
        "matchedLabels",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "SearchResourcesResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SearchResourceSummary"
          }
        },
        "truncatedTypes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SearchResourceType"
          }
        },
        "incompleteTypes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SearchResourceType"
          }
        }
      },
      "required": [
        "items",
        "truncatedTypes",
        "incompleteTypes"
      ],
      "additionalProperties": false
    },
    "HeadersVal": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "HeadersMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/HeadersVal"
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        },
        "stackTrace": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "InitiateConnectionRequest": {
      "type": "object",
      "properties": {
        "connectorId": {
          "type": "string"
        },
        "connectorVersion": {
          "type": "integer",
          "minimum": 1
        },
        "intoNamespace": {
          "$ref": "../resources/namespace/schema.json#/$defs/NamespacePath"
        },
        "returnToUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "connectorId",
        "returnToUrl"
      ],
      "additionalProperties": false
    },
    "ConnectionSetupRedirect": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "redirect"
        },
        "redirectUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "type",
        "redirectUrl"
      ],
      "additionalProperties": false
    },
    "ConnectionSetupForm": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "form"
        },
        "stepId": {
          "type": "string"
        },
        "stepTitle": {
          "type": "string"
        },
        "stepDescription": {
          "type": "string"
        },
        "jsonSchema": {
          "type": "object"
        },
        "uiSchema": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "stepId",
        "jsonSchema",
        "uiSchema"
      ],
      "additionalProperties": false
    },
    "ConnectionSetupComplete": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "complete"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false
    },
    "ConnectionSetupVerifying": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "verifying"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false
    },
    "ConnectionSetupError": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "error"
        },
        "error": {
          "type": "string"
        },
        "canRetry": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "error",
        "canRetry"
      ],
      "additionalProperties": false
    },
    "SubmitConnectionRequest": {
      "type": "object",
      "properties": {
        "stepId": {
          "type": "string"
        },
        "data": {},
        "returnToUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "stepId",
        "data"
      ],
      "additionalProperties": false
    },
    "DataSourceOption": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false
    },
    "Connection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "namespace": {
          "$ref": "../resources/namespace/schema.json#/$defs/NamespacePath"
        },
        "labels": {
          "$ref": "#/$defs/StringMap"
        },
        "annotations": {
          "$ref": "#/$defs/StringMap"
        },
        "state": {
          "$ref": "#/$defs/ConnectionState"
        },
        "healthState": {
          "$ref": "#/$defs/ConnectionHealthState"
        },
        "setupStepId": {
          "type": "string"
        },
        "setupError": {
          "type": "string"
        },
        "connector": {
          "$ref": "#/$defs/Connector"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "namespace",
        "state",
        "healthState",
        "connector",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "ListConnectionResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Connection"
          }
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "DisconnectConnectionRequest": {
      "type": "object",
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "DisconnectResponse": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string"
        },
        "connection": {
          "$ref": "#/$defs/Connection"
        }
      },
      "required": [
        "taskId",
        "connection"
      ],
      "additionalProperties": false
    },
    "MigrateConnectionVersionRequest": {
      "type": "object",
      "properties": {
        "targetVersion": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "targetVersion"
      ],
      "additionalProperties": false
    },
    "MigrateConnectionVersionResponse": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string"
        },
        "connectionId": {
          "type": "string"
        },
        "sourceVersion": {
          "type": "integer",
          "minimum": 1
        },
        "targetVersion": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "taskId",
        "connectionId",
        "sourceVersion",
        "targetVersion"
      ],
      "additionalProperties": false
    },
    "ForceConnectionStateRequest": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/ConnectionState"
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    },
    "UpdateConnectionRequest": {
      "type": "object",
      "properties": {
        "labels": {
          "$ref": "#/$defs/StringMap"
        },
        "annotations": {
          "$ref": "#/$defs/StringMap"
        }
      },
      "additionalProperties": false
    },
    "ProxyResponse": {
      "type": "object",
      "properties": {
        "statusCode": {
          "type": "integer"
        },
        "headers": {
          "$ref": "#/$defs/StringMap"
        },
        "bodyRaw": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "bodyJson": {}
      },
      "required": [
        "statusCode"
      ],
      "additionalProperties": false
    },
    "Notification": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/NotificationLevel"
        },
        "state": {
          "$ref": "#/$defs/NotificationState"
        },
        "resourceType": {
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        },
        "namespace": {
          "$ref": "../resources/namespace/schema.json#/$defs/NamespacePath"
        },
        "title": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "actionUrl": {
          "type": "string"
        },
        "canAction": {
          "type": "boolean"
        },
        "viewed": {
          "type": "boolean"
        },
        "metadata": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "resolvedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "key",
        "level",
        "state",
        "resourceType",
        "resourceId",
        "namespace",
        "title",
        "message",
        "canAction",
        "viewed",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "ListNotificationsResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Notification"
          }
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "Namespace": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "../resources/namespace/schema.json#/$defs/NamespacePath"
        },
        "state": {
          "$ref": "#/$defs/NamespaceState"
        },
        "keyId": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/StringMap"
        },
        "annotations": {
          "$ref": "#/$defs/StringMap"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "path",
        "state",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "CreateNamespaceRequest": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "../resources/namespace/schema.json#/$defs/NamespacePath"
        },
        "labels": {
          "$ref": "#/$defs/StringMap"
        },
        "annotations": {
          "$ref": "#/$defs/StringMap"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "UpdateNamespaceRequest": {
      "type": "object",
      "properties": {
        "labels": {
          "$ref": "#/$defs/StringMap"
        },
        "annotations": {
          "$ref": "#/$defs/StringMap"
        }
      },
      "additionalProperties": false
    },
    "ListNamespacesResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Namespace"
          }
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "SetNamespaceKeyRequest": {
      "type": "object",
      "properties": {
        "keyId": {
          "type": "string"
        }
      },
      "required": [
        "keyId"
      ],
      "additionalProperties": false
    },
    "NamespaceKey": {
      "type": "object",
      "properties": {
        "keyId": {
          "type": "string"
        }
      },
      "required": [
        "keyId"
      ],
      "additionalProperties": false
    },
    "Actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "namespace": {
          "$ref": "../resources/namespace/schema.json#/$defs/NamespacePath"
        },
        "externalId": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/StringMap"
        },
        "annotations": {
          "$ref": "#/$defs/StringMap"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "namespace",
        "externalId",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "CreateActorRequest": {
      "type": "object",
      "properties": {
        "externalId": {
          "type": "string"
        },
        "namespace": {
          "$ref": "../resources/namespace/schema.json#/$defs/NamespacePath"
        },
        "labels": {
          "$ref": "#/$defs/StringMap"
        },
        "annotations": {
          "$ref": "#/$defs/StringMap"
        }
      },
      "required": [
        "externalId",
        "namespace"
      ],
      "additionalProperties": false
    },
    "UpdateActorRequest": {
      "type": "object",
      "properties": {
        "labels": {
          "$ref": "#/$defs/StringMap"
        },
        "annotations": {
          "$ref": "#/$defs/StringMap"
        }
      },
      "additionalProperties": false
    },
    "ListActorsResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Actor"
          }
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "MetricsRange": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "step": {
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "step"
      ],
      "additionalProperties": false
    },
    "MetricsQueryRef": {
      "type": "object",
      "properties": {
        "refId": {
          "type": "string"
        },
        "metric": {
          "type": "string",
          "enum": [
            "request_events",
            "request_events.errors",
            "request_events.duration_ms",
            "resources.connections",
            "resources.actors",
            "resources.connectors",
            "resources.connector_versions",
            "resources.namespaces",
            "resources.rate_limits"
          ]
        },
        "aggregation": {
          "type": "string",
          "enum": [
            "count",
            "avg",
            "p95"
          ]
        },
        "groupBy": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "type",
              "method",
              "response_status_code",
              "response_source",
              "connector_id",
              "state",
              "health_state",
              "connector_version",
              "namespace",
              "mode"
            ]
          }
        }
      },
      "required": [
        "refId",
        "metric",
        "aggregation"
      ],
      "additionalProperties": false
    },
    "MetricsQueryRequest": {
      "type": "object",
      "properties": {
        "range": {
          "$ref": "#/$defs/MetricsRange"
        },
        "namespace": {
          "$ref": "../resources/namespace/schema.json#/$defs/NamespaceMatcher"
        },
        "labelSelector": {
          "type": "string"
        },
        "queries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MetricsQueryRef"
          },
          "minItems": 1
        }
      },
      "required": [
        "range",
        "queries"
      ],
      "additionalProperties": false
    },
    "MetricsPoint": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "timestamp",
        "value"
      ],
      "additionalProperties": false
    },
    "MetricsSeries": {
      "type": "object",
      "properties": {
        "refId": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "aggregation": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/StringMap"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MetricsPoint"
          }
        }
      },
      "required": [
        "refId",
        "metric",
        "aggregation",
        "points"
      ],
      "additionalProperties": false
    },
    "MetricsQueryResponse": {
      "type": "object",
      "properties": {
        "series": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MetricsSeries"
          }
        }
      },
      "required": [
        "series"
      ],
      "additionalProperties": false
    },
    "MetricsSchemaMetric": {
      "type": "object",
      "properties": {
        "metric": {
          "type": "string",
          "enum": [
            "request_events",
            "request_events.errors",
            "request_events.duration_ms",
            "resources.connections",
            "resources.actors",
            "resources.connectors",
            "resources.connector_versions",
            "resources.namespaces",
            "resources.rate_limits"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "counter",
            "gauge"
          ]
        },
        "aggregations": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "count",
              "avg",
              "p95"
            ]
          },
          "minItems": 1
        },
        "groupBy": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "type",
              "method",
              "response_status_code",
              "response_source",
              "connector_id",
              "state",
              "health_state",
              "connector_version",
              "namespace",
              "mode"
            ]
          }
        }
      },
      "required": [
        "metric",
        "kind",
        "aggregations",
        "groupBy"
      ],
      "additionalProperties": false
    },
    "MetricsSchemaResponse": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MetricsSchemaMetric"
          }
        }
      },
      "required": [
        "metrics"
      ],
      "additionalProperties": false
    },
    "Connector": {
      "description": "API summary projection of a connector version. This intentionally differs from the resource connector definition schema: fields such as logo are flattened for responses, while runtime fields such as state, has_configure, timestamps, version counts, and state summaries are added by the API. Request bodies and version detail responses reference the canonical resource schema under their definition fields.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "namespace": {
          "$ref": "../resources/namespace/schema.json#/$defs/NamespacePath"
        },
        "state": {
          "$ref": "#/$defs/ConnectorVersionState"
        },
        "displayName": {
          "type": "string"
        },
        "highlight": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "statusPageUrl": {
          "type": "string",
          "format": "uri"
        },
        "logo": {
          "type": "string"
        },
        "hasConfigure": {
          "type": "boolean"
        },
        "labels": {
          "$ref": "#/$defs/StringMap"
