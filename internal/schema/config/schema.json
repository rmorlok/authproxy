{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rmorlok/authproxy/refs/heads/main/schema/config/schema.json",
  "$defs": {
    "AdminUser": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "key": {
          "$ref": "../resources/key/schema.json#/$defs/Key"
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "../auth/schema.json#/$defs/Permission"
          }
        }
      },
      "required": [
        "username",
        "key"
      ],
      "additionalProperties": false
    },
    "AdminUsers": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AdminUser"
          }
        },
        {
          "type": "object",
          "properties": {
            "keysPath": {
              "type": "string"
            },
            "permissions": {
              "type": "array",
              "items": {
                "$ref": "../auth/schema.json#/$defs/Permission"
              }
            },
            "syncCronSchedule": {
              "type": "string"
            }
          },
          "required": [
            "keysPath"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Connectors": {
      "properties": {
        "autoMigrationLockDuration": {
          "$ref": "../common/schema.json#/$defs/HumanDuration"
        },
        "loadFromList": {
          "items": {
            "allOf": [
              {
                "$ref": "../resources/connectors/schema.json"
              },
              {
                "anyOf": [
                  {
                    "required": [
                      "id"
                    ]
                  },
                  {
                    "required": [
                      "name"
                    ]
                  }
                ]
              }
            ]
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Connections": {
      "properties": {
        "setupTtl": {
          "$ref": "../common/schema.json#/$defs/HumanDuration"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CookieConfig": {
      "properties": {
        "domain": {
          "type": "string"
        },
        "sameSite": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CorsConfig": {
      "properties": {
        "allowedOrigins": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allowedMethods": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allowedHeaders": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "exposedHeaders": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "maxAge": {
          "$ref": "../common/schema.json#/$defs/HumanDuration"
        },
        "allowCredentials": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "DatabaseSqlite": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "sqlite"
        },
        "path": {
          "type": "string"
        },
        "autoMigrationLockDuration": {
          "$ref": "../common/schema.json#/$defs/HumanDuration"
        },
        "softDeleteRetention": {
          "$ref": "../common/schema.json#/$defs/HumanDuration"
        }
      },
      "required": [
        "provider",
        "path"
      ],
      "additionalProperties": false
    },
    "DatabasePostgres": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "postgres"
        },
        "host": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        },
        "port": {
          "$ref": "../common/schema.json#/$defs/IntegerValue"
        },
        "user": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        },
        "password": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        },
        "database": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        },
        "sslmode": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        },
        "params": {
          "type": "object",
          "properties": {
            "attributes": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "autoMigrationLockDuration": {
          "$ref": "../common/schema.json#/$defs/HumanDuration"
        },
        "softDeleteRetention": {
          "$ref": "../common/schema.json#/$defs/HumanDuration"
        }
      },
      "required": [
        "provider",
        "host"
      ],
      "additionalProperties": false
    },
    "DatabaseClickhouse": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "clickhouse"
        },
        "addresses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "address": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        },
        "addressList": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        },
        "user": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        },
        "password": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        },
        "database": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "http",
            "native"
          ]
        },
        "autoMigrationLockDuration": {
          "$ref": "../common/schema.json#/$defs/HumanDuration"
        }
      },
      "oneOf": [
        {
          "required": [
            "provider",
            "addresses"
          ],
          "not": {
            "required": [
              "address",
              "addressList"
            ]
          }
        },
        {
          "required": [
            "provider",
            "address"
          ],
          "not": {
            "required": [
              "addresses",
              "addressList"
            ]
          }
        },
        {
          "required": [
            "provider",
            "addressList"
          ],
          "not": {
            "required": [
              "addresses",
              "address"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "Database": {
      "oneOf": [
        {
          "$ref": "#/$defs/DatabaseSqlite"
        },
        {
          "$ref": "#/$defs/DatabasePostgres"
        }
      ]
    },
    "DatabaseOrWarehouse": {
      "oneOf": [
        {
          "$ref": "#/$defs/DatabaseSqlite"
        },
        {
          "$ref": "#/$defs/DatabasePostgres"
        },
        {
          "$ref": "#/$defs/DatabaseClickhouse"
        }
      ]
    },
    "DevSettings": {
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fakeEncryption": {
          "type": "boolean"
        },
        "fakeEncryptionSkipBase64": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ErrorPages": {
      "properties": {
        "notFound": {
          "type": "string"
        },
        "unauthorized": {
          "type": "string"
        },
        "internalError": {
          "type": "string"
        },
        "template": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "HostApplication": {
      "properties": {
        "initiateSessionUrl": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "AppMetrics": {
      "properties": {
        "database": {
          "$ref": "#/$defs/DatabaseOrWarehouse"
        },
        "blobStorage": {
          "$ref": "#/$defs/BlobStorage"
        },
        "resourceSnapshotInterval": {
          "$ref": "../common/schema.json#/$defs/HumanDuration"
        },
        "requestEvents": {
          "$ref": "#/$defs/AppMetricsRequestEvents"
        }
      },
      "additionalProperties": false,
      "required": [
        "database"
      ],
      "type": "object"
    },
    "AppMetricsRequestEvents": {
      "properties": {
        "retention": {
          "$ref": "../common/schema.json#/$defs/HumanDuration"
        },
        "maxRequestSize": {
          "$ref": "../common/schema.json#/$defs/HumanByteSize"
        },
        "maxResponseSize": {
          "$ref": "../common/schema.json#/$defs/HumanByteSize"
        },
        "maxResponseWait": {
          "$ref": "../common/schema.json#/$defs/HumanDuration"
        },
        "fullRequestRecording": {
          "type": "string"
        },
        "fullRequestRetention": {
          "$ref": "../common/schema.json#/$defs/HumanDuration"
        },
        "flushInterval": {
          "$ref": "../common/schema.json#/$defs/HumanDuration"
        },
        "flushBatchSize": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "LoggingConfigNone": {
      "type": "object",
      "properties": {
        "type": {
          "const": "none"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "LoggingConfigText": {
      "type": "object",
      "properties": {
        "type": {
          "const": "text"
        },
        "to": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "source": {
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "LoggingConfigJson": {
      "type": "object",
      "properties": {
        "type": {
          "const": "json"
        },
        "to": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "source": {
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "LoggingConfigTint": {
      "type": "object",
      "properties": {
        "type": {
          "const": "tint"
        },
        "to": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "source": {
          "type": "boolean"
        },
        "noColor": {
          "type": "boolean"
        },
        "timeFormat": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "LoggingConfig": {
      "oneOf": [
        {
          "$ref": "#/$defs/LoggingConfigNone"
        },
        {
          "$ref": "#/$defs/LoggingConfigText"
        },
        {
          "$ref": "#/$defs/LoggingConfigJson"
        },
        {
          "$ref": "#/$defs/LoggingConfigTint"
        }
      ]
    },
    "Marketplace": {
      "properties": {
        "baseUrl": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "OAuth": {
      "properties": {
        "initiateToRedirectTtl": {
          "$ref": "../common/schema.json#/$defs/HumanDuration"
        },
        "roundTripTtl": {
          "$ref": "../common/schema.json#/$defs/HumanDuration"
        },
        "refreshTokensInBackground": {
          "type": "boolean"
        },
        "refreshTokensTimeBeforeExpiry": {
          "$ref": "../common/schema.json#/$defs/HumanDuration"
        },
        "refreshTokensCronSchedule": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Tasks": {
      "properties": {
        "defaultRetention": {
          "$ref": "../common/schema.json#/$defs/HumanDuration"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Telemetry": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "exporter": {
          "$ref": "#/$defs/TelemetryExporter"
        },
        "resource": {
          "$ref": "#/$defs/TelemetryResource"
        },
        "sampling": {
          "$ref": "#/$defs/TelemetrySampling"
        },
        "signals": {
          "$ref": "#/$defs/TelemetrySignals"
        },
        "http": {
          "$ref": "#/$defs/TelemetryHTTP"
        },
        "proxy": {
          "$ref": "#/$defs/TelemetryProxy"
        },
        "propagation": {
          "$ref": "#/$defs/TelemetryPropagation"
        }
      },
      "additionalProperties": false
    },
    "TelemetryExporter": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "enum": [
            "grpc",
            "http/protobuf"
          ]
        },
        "endpoint": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "../common/schema.json#/$defs/StringValue"
          }
        },
        "insecure": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "TelemetryResource": {
      "type": "object",
      "properties": {
        "serviceNamePrefix": {
          "type": "string"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "TelemetrySampling": {
      "type": "object",
      "properties": {
        "ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "TelemetrySignals": {
      "type": "object",
      "properties": {
        "traces": {
          "type": "boolean"
        },
        "metrics": {
          "type": "boolean"
        },
        "logs": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "TelemetryHTTP": {
      "type": "object",
      "properties": {
        "excludedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "TelemetryProxy": {
      "type": "object",
      "properties": {
        "spanAttributeLabels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metricDimensionLabels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metricDimensionValueCap": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "TelemetryPropagation": {
      "type": "object",
      "properties": {
        "injectOutboundDefault": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "RedisReal": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "redis"
        },
        "network": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "protocol": {
          "type": "integer"
        },
        "username": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        },
        "password": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        },
        "db": {
          "type": "integer"
        }
      },
      "required": [
        "address"
      ],
      "additionalProperties": false
    },
    "RedisMiniredis": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "miniredis"
        }
      },
      "required": [
        "provider"
      ],
      "additionalProperties": false
    },
    "Redis": {
      "oneOf": [
        {
          "$ref": "#/$defs/RedisReal"
        },
        {
          "$ref": "#/$defs/RedisMiniredis"
        }
      ]
    },
    "BlobStorageS3": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "s3"
        },
        "endpoint": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "bucket": {
          "type": "string"
        },
        "credentials": {
          "$ref": "../common/schema.json#/$defs/AwsCredentials"
        },
        "forcePathStyle": {
          "type": "boolean"
        },
        "prefix": {
          "type": "string"
        }
      },
      "required": [
        "bucket"
      ],
      "additionalProperties": false
    },
    "BlobStorageMemory": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "memory"
        }
      },
      "required": [
        "provider"
      ],
      "additionalProperties": false
    },
    "BlobStorageFilesystem": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "filesystem"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "path"
      ],
      "additionalProperties": false
    },
    "BlobStorage": {
      "oneOf": [
        {
          "$ref": "#/$defs/BlobStorageS3"
        },
        {
          "$ref": "#/$defs/BlobStorageMemory"
        },
        {
          "$ref": "#/$defs/BlobStorageFilesystem"
        }
      ]
    },
    "ServiceAdminApi": {
      "properties": {
        "healthCheckPort": {
          "$ref": "../common/schema.json#/$defs/IntegerValue"
        },
        "port": {
          "$ref": "../common/schema.json#/$defs/IntegerValue"
        },
        "baseUrl": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        },
        "domain": {
          "type": "string"
        },
        "https": {
          "type": "boolean"
        },
        "cors": {
          "$ref": "#/$defs/CorsConfig"
        },
        "tls": {
          "$ref": "#/$defs/TlsConfig"
        },
        "ui": {
          "$ref": "#/$defs/ServiceAdminUi"
        },
        "sessionTimeout": {
          "$ref": "../common/schema.json#/$defs/HumanDuration"
        },
        "xsrfRequestQueueDepth": {
          "type": "integer"
        },
        "static": {
          "$ref": "#/$defs/ServicePublicStaticContentConfig"
        },
        "cookie": {
          "$ref": "#/$defs/CookieConfig"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ServiceAdminUi": {
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "baseUrl": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        },
        "initiateSessionUrl": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ServiceApi": {
      "properties": {
        "healthCheckPort": {
          "$ref": "../common/schema.json#/$defs/IntegerValue"
        },
        "port": {
          "$ref": "../common/schema.json#/$defs/IntegerValue"
        },
        "baseUrl": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        },
        "domain": {
          "type": "string"
        },
        "https": {
          "type": "boolean"
        },
        "cors": {
          "$ref": "#/$defs/CorsConfig"
        },
        "tls": {
          "$ref": "#/$defs/TlsConfig"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ServicePublic": {
      "properties": {
        "healthCheckPort": {
          "$ref": "../common/schema.json#/$defs/IntegerValue"
        },
        "port": {
          "$ref": "../common/schema.json#/$defs/IntegerValue"
        },
        "baseUrl": {
          "$ref": "../common/schema.json#/$defs/StringValue"
        },
        "domain": {
          "type": "string"
        },
        "https": {
          "type": "boolean"
        },
        "cors": {
          "$ref": "#/$defs/CorsConfig"
        },
        "tls": {
          "$ref": "#/$defs/TlsConfig"
        },
        "sessionTimeout": {
          "$ref": "../common/schema.json#/$defs/HumanDuration"
        },
        "xsrfRequestQueueDepth": {
          "type": "integer"
        },
        "enableMarketplaceApis": {
          "type": "boolean"
        },
        "enableProxy": {
          "type": "boolean"
        },
        "static": {
          "$ref": "#/$defs/ServicePublicStaticContentConfig"
        },
        "cookie": {
          "$ref": "#/$defs/CookieConfig"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ServicePublicStaticContentConfig": {
      "properties": {
        "mountAt": {
          "type": "string"
        },
        "serveFrom": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ServiceWorker": {
      "properties": {
        "healthCheckPort": {
          "$ref": "../common/schema.json#/$defs/IntegerValue",
          "description": "The port on which the worker will listen for health checks."
        },
        "concurrency": {
          "$ref": "../common/schema.json#/$defs/StringValue",
          "description": "The number of concurrent tasks that a single instance of the worker will run. If not set, the default is 0, which means that the worker will use the number of CPUs to be the maximum number of parallel tasks."
        },
        "cronSyncInterval": {
          "$ref": "../common/schema.json#/$defs/HumanDuration",
          "description": "The interval at which the the system will sync the list of cron tasks. Cron tasks are both global and connection specific. If not set, the default is every 5 minutes."
        },
        "workflowPollers": {
          "$ref": "../common/schema.json#/$defs/StringValue",
          "description": "The number of workflow task pollers to start for go-workflows. If not set, the go-workflows library default is used."
        },
        "activityPollers": {
          "$ref": "../common/schema.json#/$defs/StringValue",
          "description": "The number of activity task pollers to start for go-workflows. If not set, the go-workflows library default is used."
        },
        "maxParallelWorkflowTasks": {
          "$ref": "../common/schema.json#/$defs/StringValue",
          "description": "The maximum number of concurrent workflow tasks processed by the worker. If not set, the go-workflows library default is used."
        },
        "maxParallelActivityTasks": {
          "$ref": "../common/schema.json#/$defs/StringValue",
          "description": "The maximum number of concurrent activity tasks processed by the worker. If not set, the go-workflows library default is used."
        },
        "workflowHeartbeatInterval": {
          "$ref": "../common/schema.json#/$defs/HumanDuration",
          "description": "The interval between heartbeat attempts on workflow tasks. If not set, the go-workflows library default is used."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "SystemAuth": {
      "properties": {
        "jwtSigningKey": {
          "$ref": "../resources/key/schema.json#/$defs/Key"
        },
        "jwtIssuer": {
          "type": "string"
        },
        "jwtTokenDuration": {
          "type": "integer"
        },
        "disableXsrf": {
          "type": "boolean"
        },
        "actors": {
          "$ref": "#/$defs/ConfiguredActors"
        },
        "globalAesKey": {
          "$ref": "../resources/key/schema.json#/$defs/KeyData"
        },
