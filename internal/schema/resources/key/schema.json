{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rmorlok/authproxy/refs/heads/main/schema/resources/key/schema.json",
  "$defs": {
    "Key": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "publicKey": {
              "$ref": "#/$defs/KeyData"
            },
            "privateKey": {
              "$ref": "#/$defs/KeyData"
            }
          },
          "anyOf": [
            {
              "required": [
                "publicKey"
              ]
            },
            {
              "required": [
                "privateKey"
              ]
            }
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "sharedKey": {
              "$ref": "#/$defs/KeyData"
            }
          },
          "required": [
            "sharedKey"
          ],
          "additionalProperties": false
        }
      ]
    },
    "KeyDataValue": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "KeyDataBase64": {
      "type": "object",
      "properties": {
        "base64": {
          "type": "string"
        }
      },
      "required": [
        "base64"
      ],
      "additionalProperties": false
    },
    "KeyDataEnvVar": {
      "type": "object",
      "properties": {
        "envVar": {
          "type": "string"
        }
      },
      "required": [
        "envVar"
      ],
      "additionalProperties": false
    },
    "KeyDataEnvVarBase64": {
      "type": "object",
      "properties": {
        "envVarBase64": {
          "type": "string"
        }
      },
      "required": [
        "envVarBase64"
      ],
      "additionalProperties": false
    },
    "KeyDataFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "KeyDataRandomBytes": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "numBytes": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "numBytes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "random": {
              "const": true
            },
            "numBytes": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "random"
          ],
          "additionalProperties": false
        }
      ]
    },
    "KeyDataAwsKMS": {
      "type": "object",
      "properties": {
        "awsKmsKeyId": {
          "type": "string"
        },
        "awsRegion": {
          "type": "string"
        },
        "awsKmsEndpoint": {
          "type": "string"
        },
        "awsCredentials": {
          "$ref": "../../common/schema.json#/$defs/AwsCredentials"
        },
        "cacheTtl": {
          "type": "string"
        }
      },
      "required": [
        "awsKmsKeyId"
      ],
      "additionalProperties": false
    },
    "KeyDataAwsSecret": {
      "type": "object",
      "properties": {
        "awsSecretId": {
          "type": "string"
        },
        "awsSecretKey": {
          "type": "string"
        },
        "awsRegion": {
          "type": "string"
        },
        "awsCredentials": {
          "$ref": "../../common/schema.json#/$defs/AwsCredentials"
        },
        "cacheTtl": {
          "type": "string"
        }
      },
      "required": [
        "awsSecretId"
      ],
      "additionalProperties": false
    },
    "KeyDataGcpKMS": {
      "type": "object",
      "properties": {
        "gcpKmsKeyName": {
          "type": "string"
        },
        "gcpProject": {
          "type": "string"
        },
        "gcpLocation": {
          "type": "string"
        },
        "gcpKeyRing": {
          "type": "string"
        },
        "gcpCryptoKey": {
          "type": "string"
        },
        "gcpKmsEndpoint": {
          "type": "string"
        },
        "gcpCredentialsFile": {
          "type": "string"
        },
        "gcpCredentialsJson": {
          "$ref": "../../common/schema.json#/$defs/StringValue"
        },
        "cacheTtl": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "gcpKmsKeyName"
          ]
        },
        {
          "required": [
            "gcpProject",
            "gcpLocation",
            "gcpKeyRing",
            "gcpCryptoKey"
          ]
        }
      ],
      "additionalProperties": false
    },
    "KeyDataGcpSecret": {
      "type": "object",
      "properties": {
        "gcpSecretName": {
          "type": "string"
        },
        "gcpProject": {
          "type": "string"
        },
        "gcpSecretVersion": {
          "type": "string"
        },
        "cacheTtl": {
          "type": "string"
        }
      },
      "required": [
        "gcpSecretName"
      ],
      "additionalProperties": false
    },
    "KeyDataVault": {
      "type": "object",
      "properties": {
        "vaultAddress": {
          "type": "string"
        },
        "vaultToken": {
          "type": "string"
        },
        "vaultPath": {
          "type": "string"
        },
        "vaultKey": {
          "type": "string"
        },
        "cacheTtl": {
          "type": "string"
        }
      },
      "required": [
        "vaultAddress",
        "vaultPath"
      ],
      "additionalProperties": false
    },
    "KeyDataVaultTransit": {
      "type": "object",
      "properties": {
        "vaultAddress": {
          "type": "string"
        },
        "vaultToken": {
          "type": "string"
        },
        "vaultNamespace": {
          "type": "string"
        },
        "vaultTransitMountPath": {
          "type": "string"
        },
        "vaultTransitKeyName": {
          "type": "string"
        },
        "cacheTtl": {
          "type": "string"
        }
      },
      "required": [
        "vaultAddress",
        "vaultTransitKeyName"
      ],
      "additionalProperties": false
    },
    "KeyDataMock": {
      "type": "object",
      "properties": {
        "mockId": {
          "type": "string"
        }
      },
      "required": [
        "mockId"
      ],
      "additionalProperties": false
    },
    "KeyDataMockKMS": {
      "type": "object",
      "properties": {
        "mockKmsId": {
          "type": "string"
        }
      },
      "required": [
        "mockKmsId"
      ],
      "additionalProperties": false
    },
    "KeyData": {
      "oneOf": [
        {
          "$ref": "#/$defs/KeyDataValue"
        },
        {
          "$ref": "#/$defs/KeyDataBase64"
        },
        {
          "$ref": "#/$defs/KeyDataEnvVar"
        },
        {
          "$ref": "#/$defs/KeyDataEnvVarBase64"
        },
        {
          "$ref": "#/$defs/KeyDataFile"
        },
        {
          "$ref": "#/$defs/KeyDataRandomBytes"
        },
        {
          "$ref": "#/$defs/KeyDataAwsKMS"
        },
        {
          "$ref": "#/$defs/KeyDataAwsSecret"
        },
        {
          "$ref": "#/$defs/KeyDataGcpKMS"
        },
        {
          "$ref": "#/$defs/KeyDataGcpSecret"
        },
        {
          "$ref": "#/$defs/KeyDataVault"
        },
        {
          "$ref": "#/$defs/KeyDataVaultTransit"
        },
        {
          "$ref": "#/$defs/KeyDataMock"
        },
        {
          "$ref": "#/$defs/KeyDataMockKMS"
        }
      ]
    }
  }
}
