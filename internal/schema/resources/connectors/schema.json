{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rmorlok/authproxy/refs/heads/main/schema/resources/connectors/schema.json",
  "$defs": {
    "AuthApiKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "placement"
      ],
      "properties": {
        "type": {
          "const": "api-key"
        },
        "placement": {
          "$ref": "#/$defs/ApiKeyPlacement"
        }
      }
    },
    "ConnectorTelemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "propagateTraceContext": {
          "type": "boolean"
        }
      }
    },
    "ExponentialBackoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialInterval": {
          "$ref": "../../common/schema.json#/$defs/HumanDuration"
        },
        "multiplier": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxInterval": {
          "$ref": "../../common/schema.json#/$defs/HumanDuration"
        },
        "jitterFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "RateLimiting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disabled": {
          "type": "boolean"
        },
        "retryAfterHeaders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxRetryAfter": {
          "$ref": "../../common/schema.json#/$defs/HumanDuration"
        },
        "defaultRetryAfter": {
          "$ref": "../../common/schema.json#/$defs/HumanDuration"
        },
        "exponentialBackoff": {
          "$ref": "#/$defs/ExponentialBackoff"
        }
      }
    },
    "ApiKeyPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "bearer",
            "header",
            "query",
            "basic"
          ]
        },
        "headerName": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        },
        "paramName": {
          "type": "string"
        },
        "usernameField": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "header"
              }
            }
          },
          "then": {
            "required": [
              "headerName"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "query"
              }
            }
          },
          "then": {
            "required": [
              "paramName"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "basic"
              }
            }
          },
          "then": {
            "required": [
              "usernameField"
            ]
          }
        }
      ]
    },
    "AuthNoAuth": {
      "properties": {
        "type": {
          "const": "no-auth"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "MigrationHook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "javascript"
      ],
      "properties": {
        "javascript": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "up": {
          "$ref": "#/$defs/MigrationHook"
        },
        "down": {
          "$ref": "#/$defs/MigrationHook"
        }
      }
    },
    "Probe": {
      "oneOf": [
        {
          "required": [
            "id",
            "http"
          ]
        },
        {
          "required": [
            "id",
            "proxyHttp"
          ]
        }
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "period": {
          "$ref": "../../common/schema.json#/$defs/HumanDuration"
        },
        "cron": {
          "$ref": "../../common/schema.json#/$defs/Cron"
        },
        "proxyHttp": {
          "$ref": "#/$defs/ProbeHttp"
        },
        "http": {
          "$ref": "#/$defs/ProbeHttp"
        },
        "if": {
          "$ref": "../../common/schema.json#/$defs/Predicate"
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "recoveryThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "dependencies": {
        "period": {
          "not": {
            "required": [
              "cron"
            ]
          }
        },
        "cron": {
          "not": {
            "required": [
              "period"
            ]
          }
        },
        "proxyHttp": {
          "not": {
            "required": [
              "http"
            ]
          }
        },
        "http": {
          "not": {
            "required": [
              "proxyHttp"
            ]
          }
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ProbeHttp": {
      "required": [
        "method",
        "url"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "bodyRaw": {
          "type": "string"
        },
        "bodyJson": {
          "type": "object"
        },
        "body": {
          "type": "string"
        },
        "timeout": {
          "$ref": "../../common/schema.json#/$defs/HumanDuration"
        }
      }
    },
    "SetupFlow": {
      "type": "object",
      "properties": {
        "preconnect": {
          "$ref": "#/$defs/SetupFlowPhase"
        },
        "credentials": {
          "$ref": "#/$defs/SetupFlowPhase"
        },
        "configure": {
          "$ref": "#/$defs/SetupFlowPhase"
        }
      },
      "additionalProperties": false
    },
    "SetupFlowPhase": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SetupFlowStep"
          }
        }
      },
      "additionalProperties": false
    },
    "SetupFlowStep": {
      "type": "object",
      "required": [
        "id",
        "jsonSchema"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "jsonSchema": {
          "type": "object"
        },
        "uiSchema": {
          "type": "object"
        },
        "dataSources": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/DataSourceDef"
          }
        },
        "if": {
          "$ref": "../../common/schema.json#/$defs/Predicate"
        }
      },
      "additionalProperties": false
    },
    "DataSourceDef": {
      "type": "object",
      "required": [
        "proxyRequest",
        "transform"
      ],
      "properties": {
        "proxyRequest": {
          "$ref": "#/$defs/DataSourceProxyRequest"
        },
        "transform": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "DataSourceProxyRequest": {
      "type": "object",
      "required": [
        "method",
        "url"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "ConnectorDefinition": {
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "logo": { "$ref": "../../common/schema.json#/$defs/Image" },
        "highlight": { "type": "string" },
        "description": { "type": "string" },
        "statusPageUrl": { "type": "string" },
        "marketplaceUrl": { "type": "string" },
        "developerConsoleUrl": { "type": "string" },
        "oauthClientUrl": { "type": "string" },
        "auth": {
          "oneOf": [
            { "$ref": "./schema-oauth.json" },
            { "$ref": "#/$defs/AuthApiKey" },
            { "$ref": "#/$defs/AuthNoAuth" }
          ]
        },
        "javascript": { "type": "string" },
        "migrations": { "$ref": "#/$defs/Migrations" },
        "rateLimiting": { "$ref": "#/$defs/RateLimiting" },
        "probes": {
          "type": "array",
          "items": { "$ref": "#/$defs/Probe" }
        },
        "setupFlow": { "$ref": "#/$defs/SetupFlow" },
        "telemetry": { "$ref": "#/$defs/ConnectorTelemetry" }
      },
      "required": ["displayName", "logo", "auth"],
      "additionalProperties": false
    },
    "ConnectorReleaseSpec": {
      "type": "object",
      "properties": {
        "desiredState": {
          "type": "string",
          "enum": ["draft", "primary"]
        }
      },
      "additionalProperties": false
    },
    "ConnectorSpec": {
      "type": "object",
      "properties": {
        "release": { "$ref": "#/$defs/ConnectorReleaseSpec" },
        "definition": { "$ref": "#/$defs/ConnectorDefinition" }
      },
      "required": ["definition"],
      "additionalProperties": false
    },
    "ConnectorReleaseStatus": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": ["draft", "primary", "active", "archived"]
        }
      },
      "required": ["state"],
      "additionalProperties": false
    },
    "ConnectorStatus": {
      "type": "object",
      "properties": {
        "release": { "$ref": "#/$defs/ConnectorReleaseStatus" }
      },
      "required": ["release"],
      "additionalProperties": false
    }
  },
  "allOf": [
    { "$ref": "../meta/schema.json#/$defs/Resource" },
    {
      "type": "object",
      "properties": {
        "apiVersion": { "const": "authproxy.net/v1alpha1" },
        "kind": { "const": "Connector" },
        "metadata": {
          "allOf": [
            { "$ref": "../meta/schema.json#/$defs/ObjectMeta" },
            {
              "type": "object",
              "properties": {
                "id": { "type": "string", "pattern": "^cxr_" },
                "namespace": { "$ref": "../namespace/schema.json#/$defs/NamespacePath" }
              },
              "anyOf": [
                { "required": ["id"] },
                { "required": ["name"] }
              ]
            }
          ]
        },
        "spec": { "$ref": "#/$defs/ConnectorSpec" },
        "status": { "$ref": "#/$defs/ConnectorStatus" }
      }
    }
  ],
  "unevaluatedProperties": false
}
