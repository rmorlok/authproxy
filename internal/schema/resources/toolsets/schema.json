{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rmorlok/authproxy/refs/heads/main/schema/resources/toolsets/schema.json",
  "$ref": "#/$defs/ToolSet",
  "$defs": {
    "ToolSetMetadata": {
      "allOf": [
        { "$ref": "../meta/schema.json#/$defs/ObjectMeta" },
        {
          "type": "object",
          "required": ["namespace"],
          "properties": {
            "id": { "type": "string", "pattern": "^tls_" },
            "namespace": { "$ref": "../namespace/schema.json#/$defs/NamespacePath" }
          }
        }
      ]
    },
    "ToolSetReference": {
      "allOf": [
        { "$ref": "../meta/schema.json#/$defs/ObjectReference" },
        {
          "type": "object",
          "properties": {
            "apiVersion": { "const": "authproxy.net/v1alpha1" },
            "kind": { "const": "ToolSet" },
            "id": { "type": "string", "pattern": "^tls_" },
            "namespace": { "$ref": "../namespace/schema.json#/$defs/NamespacePath" },
            "generation": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "ConnectionSelector": {
      "type": "object",
      "required": ["matchLabels"],
      "properties": {
        "namespace": {
          "anyOf": [
            { "const": "" },
            { "$ref": "../namespace/schema.json#/$defs/NamespaceMatcher" }
          ],
          "description": "Omission or an empty string uses the ToolSet namespace subtree. Go validation requires an explicit matcher to stay within that subtree."
        },
        "matchLabels": {
          "$ref": "../meta/schema.json#/$defs/Labels",
          "description": "ANDed exact matches, including inherited labels. An explicit empty object selects every eligible connection within the namespace scope."
        }
      },
      "additionalProperties": false
    },
    "TemplateLabels": {
      "allOf": [
        { "$ref": "../meta/schema.json#/$defs/Labels" },
        { "propertyNames": { "not": { "pattern": "^apxy/" } } }
      ],
      "description": "Administrator-authored labels cannot write the reserved system-label namespace."
    },
    "ToolTemplateMetadata": {
      "type": "object",
      "properties": {
        "name": { "$ref": "../../common/schema.json#/$defs/ResourceName" },
        "labels": { "$ref": "#/$defs/TemplateLabels" },
        "annotations": { "$ref": "../meta/schema.json#/$defs/Annotations" }
      },
      "additionalProperties": false
    },
    "ToolTemplate": {
      "type": "object",
      "required": ["key", "spec"],
      "properties": {
        "key": { "$ref": "../tools/schema.json#/$defs/NonBlankString" },
        "metadata": { "$ref": "#/$defs/ToolTemplateMetadata" },
        "spec": { "$ref": "../tools/schema.json#/$defs/ToolDefinition" }
      },
      "additionalProperties": false,
      "description": "A reusable authored Tool definition with a stable, exact source key. Go validation requires keys to be unique within an explicit source. Connection identity is supplied by the binding."
    },
    "ExplicitSource": {
      "type": "object",
      "required": ["tools"],
      "properties": {
        "tools": { "type": "array", "items": { "$ref": "#/$defs/ToolTemplate" } }
      },
      "additionalProperties": false,
      "description": "An explicit inventory of templates. An empty array deliberately declares an empty inventory; omission or null is invalid."
    },
    "MCPToolFilter": {
      "type": "object",
      "properties": {
        "includeNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "../tools/schema.json#/$defs/NonBlankString" }
        },
        "excludeNames": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "../tools/schema.json#/$defs/NonBlankString" }
        }
      },
      "additionalProperties": false,
      "description": "Exact upstream tool names, preserved without normalization. Omitted inclusion is unrestricted; an authored inclusion list must be nonempty."
    },
    "MCPSource": {
      "type": "object",
      "required": ["endpoint", "transport"],
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[^\\r\\n]*\\S)?$",
          "description": "The upstream endpoint, optionally containing configuration templates. Surrounding whitespace and line breaks are invalid; URL and template compilation happen later."
        },
        "transport": { "const": "streamableHttp" },
        "refreshInterval": {
          "type": "string",
          "pattern": "^[+-]?(?:0|(?:(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:ns|us|µs|μs|ms|s|m|h))+)$",
          "description": "A Go duration string preserved exactly as authored. Go validation additionally requires a positive duration within the supported numeric range."
        },
        "tools": { "$ref": "#/$defs/MCPToolFilter" }
      },
      "additionalProperties": false
    },
    "ToolSetSource": {
      "type": "object",
      "properties": {
        "explicit": { "$ref": "#/$defs/ExplicitSource" },
        "mcp": { "$ref": "#/$defs/MCPSource" }
      },
      "oneOf": [{ "required": ["explicit"] }, { "required": ["mcp"] }],
      "additionalProperties": false,
      "description": "Exactly one explicit or MCP source is authored. OpenAPI source contracts are added separately."
    },
    "PermissionAlias": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "description": "An exact additional permission verb without surrounding whitespace. Canonical verb resolution is separate from this authored alias contract."
    },
    "PermissionMappingMatch": {
      "type": "object",
      "properties": {
        "sourceKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "../tools/schema.json#/$defs/NonBlankString" }
        },
        "sourceKeyPatterns": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "../tools/schema.json#/$defs/NonBlankString" }
        }
      },
      "anyOf": [
        { "required": ["sourceKeys"], "properties": { "sourceKeys": { "minItems": 1 } } },
        { "required": ["sourceKeyPatterns"], "properties": { "sourceKeyPatterns": { "minItems": 1 } } }
      ],
      "additionalProperties": false,
      "description": "At least one exact key or pattern is required. Matchers are ORed; Go validation checks regular-expression syntax and matching covers the complete source key."
    },
    "PermissionMapping": {
      "type": "object",
      "required": ["match", "addVerbs"],
      "properties": {
        "match": { "$ref": "#/$defs/PermissionMappingMatch" },
        "addVerbs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/PermissionAlias" }
        }
      },
      "additionalProperties": false
    },
    "ToolSetDefinition": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": { "$ref": "#/$defs/ToolSetSource" },
        "permissionMappings": {
          "type": "array",
          "items": { "$ref": "#/$defs/PermissionMapping" }
        }
      },
      "if": { "required": ["permissionMappings"] },
      "then": { "properties": { "source": { "required": ["mcp"] } } },
      "additionalProperties": false
    },
    "ToolSetReleaseSpec": {
      "type": "object",
      "properties": {
        "desiredState": { "type": "string", "enum": ["draft", "primary"] }
      },
      "additionalProperties": false
    },
    "ToolSetSpec": {
      "type": "object",
      "required": ["connectionSelector", "definition"],
      "properties": {
        "connectionSelector": { "$ref": "#/$defs/ConnectionSelector" },
        "release": { "$ref": "#/$defs/ToolSetReleaseSpec" },
        "definition": { "$ref": "#/$defs/ToolSetDefinition" }
      },
      "additionalProperties": false
    },
    "ToolSetReleaseStatus": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": { "type": "string", "enum": ["draft", "primary", "active", "archived"] }
      },
      "additionalProperties": false
    },
    "ToolSetStatus": {
      "type": "object",
      "required": ["release"],
      "properties": {
        "release": { "$ref": "#/$defs/ToolSetReleaseStatus" }
      },
      "additionalProperties": false
    },
    "ToolSetMetadataPatch": {
      "allOf": [
        { "$ref": "../meta/schema.json#/$defs/ObjectMetaPatch" },
        {
          "type": "object",
          "properties": {
            "id": { "type": "string", "pattern": "^tls_" },
            "namespace": { "$ref": "../namespace/schema.json#/$defs/NamespacePath" },
            "generation": { "type": "integer", "minimum": 1 },
            "createdAt": false,
            "updatedAt": false
          }
        }
      ]
    },
    "ToolSetReleaseSpecPatch": {
      "$ref": "#/$defs/ToolSetReleaseSpec",
      "description": "An omitted desiredState or empty object leaves publication intent unchanged. Explicit null is invalid."
    },
    "ToolSetSpecPatch": {
      "type": "object",
      "properties": {
        "connectionSelector": { "$ref": "#/$defs/ConnectionSelector" },
        "release": { "$ref": "#/$defs/ToolSetReleaseSpecPatch" },
        "definition": { "$ref": "#/$defs/ToolSetDefinition" }
      },
      "additionalProperties": false,
      "description": "Omitted fields remain unchanged. A supplied selector or definition replaces the complete value; release alone is partial. Explicit null is invalid for each field."
    },
    "ToolSetPatch": {
      "allOf": [
        { "$ref": "../meta/schema.json#/$defs/TypeMeta" },
        {
          "type": "object",
          "required": ["metadata", "spec"],
          "properties": {
            "apiVersion": { "const": "authproxy.net/v1alpha1" },
            "kind": { "const": "ToolSet" },
            "metadata": { "$ref": "#/$defs/ToolSetMetadataPatch" },
            "spec": { "$ref": "#/$defs/ToolSetSpecPatch" },
            "status": false
          }
        }
      ],
      "unevaluatedProperties": false,
      "description": "An authored update requires metadata and spec objects, which may be empty. Generation selection, immutable identity, and publication policy are enforced by Go validation with the stored resource and endpoint context."
    },
    "ToolSet": {
      "allOf": [
        { "$ref": "../meta/schema.json#/$defs/Resource" },
        {
          "type": "object",
          "properties": {
            "apiVersion": { "const": "authproxy.net/v1alpha1" },
            "kind": { "const": "ToolSet" },
            "metadata": { "$ref": "#/$defs/ToolSetMetadata" },
            "spec": { "$ref": "#/$defs/ToolSetSpec" },
            "status": { "$ref": "#/$defs/ToolSetStatus" }
          }
        }
      ],
      "unevaluatedProperties": false,
      "description": "The logical selector remains outside the generation-owned definition. Lifecycle validation applies server-owned metadata/status rules and stored-generation requirements."
    }
  }
}
